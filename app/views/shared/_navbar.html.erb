<nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100">

  <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">

    <!-- Logo -->
    <div class="text-xl font-semibold tracking-tight">
      <%= link_to root_path, class: "flex items-center gap-1" do %>
        <%= image_tag "Logo.png", alt: "LunchIn Italy Logo", class: "h-7 w-auto object-contain" %>
        <span class="text-[#1a2332]">Lunch</span>
        <span class="text-green-600">In</span>
        <span class="text-[#1a2332]">Italy</span>
        <span class="text-xs align-super">™</span>
      <% end %>
    </div>

    <!-- Navigation -->
    <div class="flex items-center gap-6 text-md font-medium">

      <%= link_to "Cities", cities_path, class: "text-gray-700 hover:text-green-600 transition" %>
      <%= link_to "How It Works", how_it_works_path, class: "text-gray-700 hover:text-green-600 transition" %>
      <%= link_to "Events", events_path, class: "text-gray-700 hover:text-green-600 transition" %>
      <%= link_to "Matching", matching_path, class: "text-gray-700 hover:text-green-600 transition" %>
      <%= link_to "Membership", membership_path, class: "text-gray-700 hover:text-green-600 transition" %>

      <!-- Language Dropdown -->
     <div class="relative" id="lang-dropdown">

        <!-- Current Language -->
        <button onclick="toggleLangMenu()"
                class="flex items-center gap-2 text-gray-500 hover:text-green-600 transition focus:outline-none">

          <%= image_tag "flag.gb.jpg",
            id: "lang-flag",
            class: "w-5 h-4 rounded-sm object-cover",
            alt: "English" %>

          <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Dropdown -->
        <div id="lang-menu"
             class="hidden absolute right-0 mt-2 w-40 bg-white border border-gray-100 rounded-lg shadow-lg z-50">

        <button onclick="setLang('en', '<%= asset_path("flag.gb.jpg") %>', 'English')"
             class="flex items-center gap-2 w-full px-4 py-2 text-sm text-gray-700 hover:bg-green-50 hover:text-green-600 rounded-t-lg">
          <%= image_tag "flag.gb.jpg", class: "w-5 h-4 rounded-sm object-cover" %>
          English
        </button>

        <button onclick="setLang('it', '<%= asset_path("flag.it.jpg") %>', 'Italiano')"
             class="flex items-center gap-2 w-full px-4 py-2 text-sm text-gray-700 hover:bg-green-50 hover:text-green-600">
          <%= image_tag "flag.it.jpg", class: "w-5 h-4 rounded-sm object-cover" %>
          Italiano
        </button>

       <button onclick="setLang('de', '<%= asset_path("flag.de.jpg") %>', 'Deutsch')"
             class="flex items-center gap-2 w-full px-4 py-2 text-sm text-gray-700 hover:bg-green-50 hover:text-green-600 rounded-b-lg">
          <%= image_tag "flag.de.jpg", class: "w-5 h-4 rounded-sm object-cover" %>
          Deutsch
        </button>

      </div>
    </div>

    <script>
      function toggleLangMenu() {
        document.getElementById('lang-menu').classList.toggle('hidden');
      }

      function setLang(code, flagUrl, label) {
        const flag = document.getElementById('lang-flag');

        flag.src = flagUrl;
        flag.alt = label;

        document.getElementById('lang-menu').classList.add('hidden');

        // Cookie speichern (1 Jahr)
        document.cookie = "locale=" + code + ";path=/;max-age=31536000";
      }

      // Close on outside click
      document.addEventListener('click', function(e) {
        const dropdown = document.getElementById('lang-dropdown');
        if (dropdown && !dropdown.contains(e.target)) {
          document.getElementById('lang-menu').classList.add('hidden');
        }
      });
    </script>

      <!-- Login -->
      <%= link_to "Login", new_user_session_path,
        class: "border border-green-600 text-green-600 px-4 py-2 rounded-lg hover:bg-green-50 transition" %>

      <!-- Sign Up -->
      <%= link_to "Sign Up", new_user_registration_path,
        class: "bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition shadow-sm" %>

    </div>

  </div>
</nav>
