<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">

  <div class="max-w-md w-full">
    <div class="bg-white rounded-2xl shadow-lg p-8">

      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl mb-2">
          Welcome to Lunch<span class="text-green-600">In</span>
        </h1>
        <p class="text-gray-600">Sign in to continue</p>
      </div>

      <!-- Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>

        <!-- Email -->
        <div>
          <%= f.label :email, class: "block text-sm mb-2 text-gray-700" %>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">✉️</span>
            <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "w-full pl-12 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none",
              placeholder: "your@email.com" %>
          </div>
        </div>

        <!-- Password -->
        <div>
          <%= f.label :password, class: "block text-sm mb-2 text-gray-700" %>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">🔒</span>

            <%= f.password_field :password,
              autocomplete: "current-password",
              id: "password",
              class: "w-full pl-12 pr-12 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none",
              placeholder: "••••••••" %>

            <button type="button"
                    onclick="togglePassword()"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
              👁
            </button>
          </div>
        </div>

        <!-- Options -->
        <div class="flex items-center justify-between text-sm">

          <label class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded border-gray-300 text-green-600" %>
            <span class="text-gray-700">Remember me</span>
          </label>

          <%= link_to "Forgot password?", new_password_path(resource_name),
            class: "text-green-600 hover:text-green-700" %>
        </div>

        <!-- Submit -->
        <%= f.submit "Sign In",
          class: "w-full bg-green-600 text-white py-3 rounded-lg hover:bg-green-700 transition-colors" %>

      <% end %>

      <!-- Divider -->
      <div class="mt-6 mb-6 flex items-center gap-4">
        <div class="flex-1 border-t border-gray-300"></div>
        <span class="text-gray-500 text-sm">or</span>
        <div class="flex-1 border-t border-gray-300"></div>
      </div>

      <!-- Register -->
      <div class="text-center">
        <p class="text-gray-600">
          Don't have an account?
          <%= link_to "Sign up now", new_user_registration_path,
            class: "text-green-600 hover:text-green-700" %>
        </p>
      </div>

    </div>
  </div>
</div>

<script>
  function togglePassword() {
    const input = document.getElementById("password");
    input.type = input.type === "password" ? "text" : "password";
  }
</script>
