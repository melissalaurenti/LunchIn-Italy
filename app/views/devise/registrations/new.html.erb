<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl w-full">
    <div class="bg-white rounded-2xl shadow-lg p-8">

      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl mb-2">
          Welcome to Lunch<span class="text-green-600">In</span>
        </h1>
        <p class="text-gray-600">Create your free account</p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Name -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :first_name, "First Name", class: "block text-sm mb-2 text-gray-700" %>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">👤</span>
              <%= f.text_field :first_name,
                class: "w-full pl-12 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none transition-all",
                placeholder: "Marco",
                required: true %>
            </div>
          </div>

          <div>
            <%= f.label :last_name, "Last Name", class: "block text-sm mb-2 text-gray-700" %>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">👤</span>
              <%= f.text_field :last_name,
                class: "w-full pl-12 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none transition-all",
                placeholder: "Rossi",
                required: true %>
            </div>
          </div>
        </div>

        <!-- Email -->
        <div>
          <%= f.label :email, "Email", class: "block text-sm mb-2 text-gray-700" %>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">✉️</span>
            <%= f.email_field :email,
              autocomplete: "email",
              class: "w-full pl-12 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none transition-all",
              placeholder: "marco.rossi@email.com",
              required: true %>
          </div>
        </div>

        <!-- Password -->
        <div>
          <%= f.label :password, "Password", class: "block text-sm mb-2 text-gray-700" %>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">🔒</span>
            <%= f.password_field :password,
              id: "register-password",
              autocomplete: "new-password",
              class: "w-full pl-12 pr-12 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none transition-all",
              placeholder: "At least 8 characters",
              required: true,
              minlength: 8 %>

            <button type="button"
                    onclick="toggleRegisterPassword()"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
              👁
            </button>
          </div>
        </div>

        <!-- Company Info -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :company, "Company", class: "block text-sm mb-2 text-gray-700" %>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">💼</span>
              <%= f.text_field :company,
                class: "w-full pl-12 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none transition-all",
                placeholder: "Your company" %>
            </div>
          </div>

          <div>
            <%= f.label :job, "Position", class: "block text-sm mb-2 text-gray-700" %>
            <%= f.text_field :job,
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none transition-all",
              placeholder: "e.g. Marketing Manager" %>
          </div>
        </div>

        <!-- City & Industry -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :city_id, "City", class: "block text-sm mb-2 text-gray-700" %>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">📍</span>
              <%= f.collection_select :city_id,
                City.order(:name),
                :id,
                :name,
                { prompt: "Select city" },
                { class: "w-full pl-12 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none transition-all appearance-none", required: true } %>
            </div>
          </div>

          <div>
            <%= f.label :industry, "Industry", class: "block text-sm mb-2 text-gray-700" %>
            <%= f.select :industry,
              [
                ["Select industry", ""],
                ["Tech & IT", "tech"],
                ["Finance", "finance"],
                ["Fashion & Design", "fashion"],
                ["Consulting", "consulting"],
                ["Marketing", "marketing"],
                ["Tourism", "tourism"],
                ["Culture & Arts", "culture"],
                ["Other", "other"]
              ],
              {},
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-600 focus:border-transparent outline-none transition-all appearance-none",
              required: true %>
          </div>
        </div>

        <!-- Terms -->
        <div class="flex items-start gap-2">
          <input type="checkbox"
                 class="mt-1 rounded border-gray-300 text-green-600 focus:ring-green-600"
                 required>
          <span class="text-sm text-gray-700">
            I accept the
            <%= link_to "Terms & Conditions", "#", class: "text-green-600 hover:text-green-700" %>
            and
            <%= link_to "Privacy Policy", "#", class: "text-green-600 hover:text-green-700" %>
          </span>
        </div>

        <%= f.submit "Create Account",
          class: "w-full bg-green-600 text-white py-3 rounded-lg hover:bg-green-700 transition-colors" %>
      <% end %>

      <!-- Login Link -->
      <div class="mt-6 text-center">
        <p class="text-gray-600">
          Already have an account?
          <%= link_to "Sign in", new_user_session_path,
            class: "text-green-600 hover:text-green-700" %>
        </p>
      </div>

    </div>
  </div>
</div>

<script>
  function toggleRegisterPassword() {
    const input = document.getElementById("register-password");
    input.type = input.type === "password" ? "text" : "password";
  }
</script>
